# Secrets — never commit real values.
# .env.example is the committed template and is explicitly re-included.
.env
.env.*
!.env.example
*.pem

.claude/docs/commit-message.md

# Personal Claude Code settings — permissions and preferences per machine.
# .claude/settings.json is the shared one and IS committed.
.claude/settings.local.json

# Build output. scripts/package-eb.mjs writes the EB source bundle here.
dist/
