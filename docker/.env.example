# CampusVibe local development environment.
#
#   cp .env.example .env     then fill in real values in .env
#
# .env is gitignored and must never be committed. Do not put real secrets in
# this file — it IS committed.
#
# In production these same variable names are supplied as Elastic Beanstalk
# environment properties instead. The application never changes; only the
# source of these values does. See EB-DEPLOYMENT.md.

# --- Spring profile -----------------------------------------------------
# Which application-<profile>.yml is layered on top of application.yml.
# `dev` locally, `prod` in Elastic Beanstalk. Leave it as dev unless you are
# deliberately reproducing production behaviour, and note that the test suites
# set their own profiles and ignore this entirely.
SPRING_PROFILES_ACTIVE=dev

# --- Database -----------------------------------------------------------
POSTGRES_DB=campusvibe
POSTGRES_USER=arpan
# Required. Any value for local dev; use a real generated password in production.
#
# Applied ONCE, when Postgres initializes an empty db_data volume. Editing it
# later does not change the password of a role that already exists — the backend
# then fails with `28P01 password authentication failed` while the db container
# still reports healthy (pg_isready never authenticates). To rotate it, either:
#   docker exec campusvibe-db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
#     -c "ALTER USER \"$POSTGRES_USER\" WITH PASSWORD '"'"'$POSTGRES_PASSWORD'"'"'"'
#   (keeps your data; local socket auth is trust, so the old password is not needed)
# or `docker compose down -v`, which wipes the volume and re-initializes. See BUG-020.
POSTGRES_PASSWORD=change-me-locally

# --- JWT signing --------------------------------------------------------
# Required. Minimum 32 bytes for HS256 — the app refuses to start otherwise.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# --- OpenAI (semantic search embeddings) --------------------------------
# OPTIONAL. Leave blank to run search in keyword-only mode with no OpenAI
# calls and no cost. Set it to enable hybrid semantic search.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CONNECT_TIMEOUT=2s
OPENAI_READ_TIMEOUT=10s
OPENAI_MAX_RETRIES=2

# --- Frontend → backend -------------------------------------------------
# Two URLs for one backend, because two different clients call it.
#
# NEXT_PUBLIC_API_URL is the address the *browser* uses, so it must be one your
# machine can reach. It is inlined into the client bundle at build time.
#
# API_INTERNAL_URL is the address *server-rendered pages* use, from inside the
# frontend container, where `localhost` is that container rather than your
# machine. Compose resolves `backend` on its own network. Leave both unset for
# normal Docker development — the defaults in docker-compose.yml are correct.
# Running `npm run dev` outside Docker needs neither: localhost:8080 works from
# both sides, and API_INTERNAL_URL falls back to the public URL when unset.
#
# Do not rename API_INTERNAL_URL to NEXT_PUBLIC_*. That would inline a Docker
# service name into the browser bundle, where it resolves to nothing.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=

# --- Google OAuth -------------------------------------------------------
# OPTIONAL. Both take the SAME Web-application client ID from Google Cloud
# Console — a public identifier, not a secret. Fill in both or neither.
#
# GOOGLE_CLIENT_ID is the audience GoogleTokenVerifier validates the ID token
# against. NEXT_PUBLIC_GOOGLE_CLIENT_ID is inlined into the browser bundle so
# Google Identity Services can start the flow; leave it blank and the sign-in
# button is replaced by "Google sign-in is not configured".
#
# The client *secret* is not used: the GIS ID-token flow never needs one.
#
# Google refuses to render for an unregistered origin, so add
# http://localhost:3000 to the client's Authorized JavaScript origins. No
# redirect URI is needed — the credential comes back to a JS callback.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Mail (password reset, email verification) ---------------------------
# OPTIONAL. Leave SPRING_MAIL_HOST unset and the backend logs every message —
# reset and confirmation links included — instead of sending it. That is the
# intended local setup: both flows work end to end, read the link out of
# `docker compose logs backend`, no mail account required.
#
# Do NOT set SPRING_MAIL_HOST to an empty string to mean 'off'. An empty value
# still counts as set: the app would select the SMTP sender pointed at host "",
# and Boot's mail health indicator would report the whole application DOWN.
# Unset means off.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@campusvibe.local

# Where links in emails point — the FRONTEND, not the API. A reset link has to
# open a page a human can type into. Must be the public address in production.
APP_BASE_URL=http://localhost:3000

# --- First platform administrator ----------------------------------------
# Every admin path is behind hasRole('ADMIN') -- creating clubs, approving the
# club-admin requests that install a club's first owner, /search/reindex. With
# no admin account none of them is reachable by anyone, and there is deliberately
# no unauthenticated endpoint to mint one. This is that door, and it is bolted
# shut unless you open it.
#
# Set ENABLED=true and EMAIL to an address that has ALREADY signed up, and the
# account is granted ROLE_ADMIN on the next start. That is the normal path, and
# the only one that works for a Google account -- it has no password to set.
#
# PASSWORD is used only when the address has no account at all, in which case
# one is created and hashed the same way sign-up would. Leave it blank
# otherwise. Do not put a real address or password in THIS file: it is committed.
#
# Grants only. Turning ENABLED back to false, or changing the address, never
# takes ROLE_ADMIN away from anyone -- revoking is a deliberate manual act.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# --- Auth policy ---------------------------------------------------------
# Refuse sign-in to an email/password account whose address has never been
# confirmed. OFF by default: it is a real barrier against throwaway addresses,
# but it locks out anyone whose confirmation mail never arrives, so turning it
# on is a product call. Google accounts are unaffected — Google has already
# proven the address.
AUTH_REQUIRE_VERIFIED_EMAIL=false

# Rate limiting on the unauthenticated auth endpoints. Defaults are sensible;
# these exist for tuning and for turning it off in a controlled test.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_IP_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX_FAILED_LOGINS=5
AUTH_RATE_LIMIT_LOCKOUT=15m
# MUST be true in production behind a load balancer, or every caller shares one
# bucket. MUST stay false if the app is exposed directly — the header is
# caller-supplied, so trusting it there lets anyone forge an IP per request.
AUTH_RATE_LIMIT_TRUST_XFF=false

# --- Profile -------------------------------------------------------------
# `dev` locally, `prod` in Elastic Beanstalk. This is the switch that decides
# whether DevDataSeeder exists as a bean at all, so a production environment
# that forgets to set `prod` would seed demo clubs. EB sets it explicitly.
SPRING_PROFILES_ACTIVE=dev

# --- Initial administrator ------------------------------------------------
# A fresh database has no admin, and creating clubs, assigning club admins and
# reindexing search all require ROLE_ADMIN — so without this there is no way in.
#
# Normal use: sign up through the app, put that address here, set ENABLED=true,
# restart. The account is promoted; no password is involved, which is also the
# only route that works for a Google account.
#
# PASSWORD is only read when the address does not exist yet, to create the
# account outright. Leave it blank otherwise. Never commit a real value.
#
# The runner never revokes: changing the email later does not demote the
# previous admin. Set ENABLED=false again once the admin exists.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Administrator

# Demo clubs for local development, created through ClubService so their search
# embeddings are populated. Only ever runs under the `dev` profile, and only
# when the clubs table is empty.
DEV_SEED_ENABLED=true

# --- AWS ----------------------------------------------------------------
# Credentials are NOT set here. The backend uses the AWS default credential
# provider chain (see s3/S3Config.java), which resolves an IAM instance/task
# role in production and your local `aws configure` profile in development.
# Never add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to this file.
AWS_REGION=us-east-1
AWS_S3_MOCK=true
AWS_S3_BUCKET_CLUBS=campusvibe-clubs
AWS_S3_BUCKET_EVENTS=campusvibe-events
