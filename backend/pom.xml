<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!--
		  A floor, not a preference. 3.5.16 is the first 3.5.x that manages
		  spring-security 6.5.11 (CVE-2026-22732); anything older ships a jar the
		  docker job rejects (BUG-019). As of 2026-09-03 it is also the newest
		  3.5.x published, which is why Tomcat is pinned separately below.

		  It no longer settles Tomcat on its own — see <tomcat.version> below.
		-->
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.campusvibe</groupId>
	<artifactId>campusvibe</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>campusvibe</name>
	<description>Backend for CampusVibe web-app</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	
	<properties>
		<java.version>25</java.version>

		<!--
		  Overrides the BOM. spring-boot-starter-parent 3.5.16 manages
		  tomcat-embed-core 10.1.55, which carries three CRITICALs the Trivy gate
		  in _docker.yml fails on: CVE-2026-65182 (longest-prefix security
		  constraint bypass), CVE-2026-65905 (replay against DIGEST auth) and
		  CVE-2026-68525 (redirect after FORM auth bypasses method-specific
		  constraints). All three are fixed at 10.1.58 (BUG-035).

		  10.1.59 rather than the 10.1.58 the advisories name, because 10.1.58 was
		  never published to Maven Central. 10.1.59 is the first release that both
		  exists and satisfies the range — copying the number out of the scanner
		  report gives a build that cannot resolve.

		  An override and not a parent bump, which is what BUG-019 did for this
		  same failure, because 3.5.16 was the newest 3.5.x there was. The only
		  parent above it is 4.0.x, a major that failed both CI tiers as of
		  2026-09-03 (Dependabot #17), and a framework migration is not a CVE
		  remedy. BUG-019's note that the parent version is "the only lever" held
		  while the 3.5 line still had room above the pin; it does not hold here.

		  This moves all four tomcat-embed-* artifacts together — the BOM declares
		  every one of them at this property. Drop the override once a parent
		  manages 10.1.58 or newer, not before.
		-->
		<tomcat.version>10.1.59</tomcat.version>

		<jsonwebtoken.version>0.13.0</jsonwebtoken.version>
	</properties>

	<dependencies>
		<!-- Database migration -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Bounded, expiring in-memory counters for auth rate limiting and
		     account lockout. Version managed by spring-boot-starter-parent. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<!-- Password reset and email verification links. Provides JavaMailSender,
		     which SmtpMailSender wraps; with no spring.mail.host configured the
		     application uses LoggingMailSender instead and sends nothing. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			Provides /actuator/health. Without it the management.endpoints block
			in application.yml is inert config: the endpoint is never created,
			the request falls through to static-resource handling, and the global
			exception handler answers 500. Every readiness probe then fails
			against a perfectly healthy application — which is exactly what hung
			both the database and docker CI jobs for their full timeout (BUG-015).
			ActuatorHealthEndpointTest guards this; do not remove one without the
			other.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>


		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Test Database -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- new dependencies added here: -->

		<dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jsonwebtoken.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jsonwebtoken.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jsonwebtoken.version}</version>
            <scope>runtime</scope>
        </dependency>
		<dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.54.9</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.22.0</version>
        </dependency>

		<!-- Google ID token verification -->
		<dependency>
			<groupId>com.google.oauth-client</groupId>
			<artifactId>google-oauth-client</artifactId>
			<version>1.39.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>2.9.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.http-client</groupId>
			<artifactId>google-http-client-jackson2</artifactId>
			<version>1.43.3</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!--
			  Splits the suite in two by class-name convention:

			    surefire  (test phase)              *Test  — plain unit tests,
			                                        no Spring context, no Docker
			    failsafe  (integration-test/verify) *IT    — @SpringBootTest and
			                                        Testcontainers suites

			  So `./mvnw test` is a fast local loop, and CI's fast tier runs
			  `./mvnw verify -DskipITs` — still producing the jar, just without
			  the slow half. `-DskipITs` is failsafe's own property; nothing
			  extra is needed to make it work.

			  AbstractIntegrationTest keeps its name: surefire's default includes
			  match it, but both plugins skip abstract classes.

			  No <executions> here on purpose. spring-boot-starter-parent already
			  binds integration-test and verify in its pluginManagement; merely
			  declaring the plugin activates that binding. Adding our own
			  execution would run every IT twice.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
